; Godot project for simplenono (ADR-0001). Prefer editing in the editor.
; config_version=5 is Godot 4.x.

config_version=5

[application]

config/name="simplenono"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
run/main_scene="res://presentation/shell.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

