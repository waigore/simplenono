class_name AudioCues
extends RefCounted
## Aesthetic cue IDs mapped to catalog asset IDs: the one place a cue becomes a
## catalog asset (specs/aesthetics/sound.md, specs/assets/access.md [code]ACC.A1[/code]).
##
## The five values are [b]SND[/b] cue IDs, not asset IDs, and [b]CMP-shell[/b] R6's
## [code]resolve(asset_id)[/code] never interprets a cue. The catalog is the upstream
## record of which asset sounds for which cue: each audio entry's [code]serves[/code]
## lists its cue. [code]SND.X1[/code]-[code]X3[/code] are the fill, cross, and clear
## marks, [code]SND.M1[/code] the bed, and [code]SND.M2[/code] the solve sting
## ([code]G1[/code]/[code]G2[/code]).
##
## Constant data only: no paths, handles, loading, or manifest access. The IDs were
## generated by [code].github/scripts/new_asset_id.py[/code] and come from
## [code]assets/catalog/[/code]; they appear in no other file under [code]game/[/code],
## and [code]test_asset_resolver.gd[/code] cross-checks each one against its catalog
## entry's [code]state[/code] and [code]serves[/code].

## [code]SND.X1[/code]: the fill mark tick ([code]ACC.G1[/code]).
const FILL_TICK := &"SND.X1"

## [code]SND.X2[/code]: the cross mark tick ([code]ACC.G1[/code]).
const CROSS_TICK := &"SND.X2"

## [code]SND.X3[/code]: the clear mark tick ([code]ACC.G1[/code]).
const CLEAR_TICK := &"SND.X3"

## [code]SND.M1[/code]: the music bed ([code]ACC.G2[/code]).
const MUSIC_BED := &"SND.M1"

## [code]SND.M2[/code]: the 1 s solve sting over the bed ([code]ACC.G2[/code]).
const SOLVE_STING := &"SND.M2"

## Cue ID → catalog asset ID. The single source of that mapping under [code]game/[/code].
const ASSET_IDS := {
	FILL_TICK: "01a19655-13d1-7499-ad4d-6079f4889628",
	CROSS_TICK: "01a1965b-6869-7ff0-9348-cee90fb49dbc",
	CLEAR_TICK: "01a19663-6589-78f1-8c76-c5a42d2a947e",
	MUSIC_BED: "01a19664-1770-773c-a39d-c50fde9479e2",
	SOLVE_STING: "01a19665-8f4b-7165-9cff-1be30a753fd6",
}
